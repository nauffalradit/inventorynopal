APP_NAME="Nopal A1 Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default: Neon (online). Aplikasi sudah terintegrasi Neon — tidak perlu postgres lokal.
# Isi kredensial asli di file .env (gitignored), JANGAN di file ini.
DB_CONNECTION=pgsql
DB_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=10"
DB_HOST=ep-blue-glade-ap47rp3k.c-7.us-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=ganti-dengan-password-neon
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# Alternatif lokal (test case saja): aktifkan postgres via --profile local-db
# Matikan DB_URL di atas, uncomment blok di bawah:
#DB_HOST=postgres
#DB_DATABASE=inventory
#DB_USERNAME=inventory
#DB_PASSWORD=secret
#DB_SSLMODE=prefer
#DB_CHANNEL_BINDING=disable

SESSION_DRIVER=file
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS=inventory@example.com
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=422652086632-5dsm185qr42m95pvmbsmv66qlvg7uc27.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ganti-dengan-client-secret-google
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# RBAC hybrid fallback (super-admin emergency jika role DB terhapus)
ADMIN_EMAILS=""

# Fase 1: kunci pendaftaran — open (demo) | domain (hanya @client.com) | invite (hanya user yang sudah ada di DB)
REGISTRATION_MODE=open
ALLOWED_DOMAINS=""

DOKU_SANDBOX=true
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_PAYMENT_DUE_DATE=60
